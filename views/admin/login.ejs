<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>دخول لوحة التحكم</title>
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet" />
</head>
<body class="login-body">
  <form class="login-card" action="/admin/login" method="post">
    <h1>🔐 دخول لوحة التحكم</h1>
    <p class="muted">أدخل كلمة المرور لإدارة المتجر</p>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <label>كلمة المرور
      <input type="password" name="token" required class="input" autofocus />
    </label>
    <button class="btn btn-primary btn-block" type="submit">دخول</button>
    <p class="muted small">افتراضي: <code>admin123</code> (غيّره من الإعدادات بعد الدخول)</p>
  </form>
</body>
</html>
