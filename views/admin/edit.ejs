<%- include('../partials/admin-header') %>

<% const p = product || {}; %>
<% const action = product ? `/admin/products/${product.id}` : '/admin/products'; %>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<form action="<%= action %>" method="post" enctype="multipart/form-data" class="form-grid">
  <div class="form-main">
    <label>اسم المنتوج *
      <input name="name" required class="input" value="<%= p.name || '' %>" />
    </label>
    <label>الوصف
      <textarea name="description" class="input" rows="6"><%= p.description || '' %></textarea>
    </label>

    <div class="form-row">
      <label>سعر البيع (يظهر للزبون) *
        <input name="selling_price" type="number" step="0.01" min="0" class="input" value="<%= p.selling_price || '' %>" />
      </label>
      <label>السعر الأصلي (مخفي عن الزبون)
        <input name="original_price" type="number" step="0.01" min="0" class="input" value="<%= p.original_price || '' %>" placeholder="مثال: 120" />
        <small class="muted">يُستخدم لحساب نسبة الربح. لن يظهر في الواجهة العامة أبداً.</small>
      </label>
    </div>

    <div class="form-row">
      <label>المخزون
        <input name="stock" type="number" min="0" class="input" value="<%= p.stock != null ? p.stock : 5 %>" />
      </label>
      <label>الفئة
        <select name="category_id" class="input">
          <option value="">— بدون فئة —</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= p.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </label>
    </div>

    <label>أو فئة جديدة
      <input name="new_category" class="input" placeholder="اكتب اسم فئة جديدة إذا لم تكن موجودة" />
    </label>
  </div>

  <aside class="form-side">
    <label>رابط الصورة
      <input name="image_url" type="url" class="input" value="<%= p.image_url || '' %>" placeholder="https://…" />
    </label>
    <label>أو ارفع صورة من جهازك
      <input name="image" type="file" accept="image/*" class="input" />
    </label>
    <% if (p.image_url) { %>
      <img src="<%= p.image_url %>" alt="" class="preview-img" />
    <% } %>

    <label>رابط المصدر (اختياري)
      <input name="source_url" type="url" class="input" value="<%= p.source_url || '' %>" />
    </label>
    <label>الموقع المصدر
      <input name="source_domain" class="input" value="<%= p.source_domain || '' %>" placeholder="مثال: amazon.com" />
    </label>

    <label class="check">
      <input type="checkbox" name="is_published" <%= p.is_published === 0 ? '' : 'checked' %> />
      <span>منشور (يظهر في المتجر)</span>
    </label>

    <button class="btn btn-primary btn-block" type="submit">
      <%= product ? '💾 حفظ التعديلات' : '💾 حفظ ونشر' %>
    </button>
    <a href="/admin/products" class="btn btn-ghost btn-block">إلغاء</a>
  </aside>
</form>

<%- include('../partials/admin-footer') %>
