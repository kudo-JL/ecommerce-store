<%- include('../partials/admin-header') %>

<% function getSet(k, d) { return (typeof settings !== 'undefined' && settings && settings[k]) || d; } %>

<% if (saved) { %><div class="alert ok">✅ تم حفظ الإعدادات.</div><% } %>

<form action="/admin/settings" method="post" class="form-stack">
  <fieldset>
    <legend>معلومات المتجر</legend>
    <label>اسم المتجر
      <input name="store_name" class="input" value="<%= settings.store_name || '' %>" />
    </label>
    <label>الشعار
      <input name="store_tagline" class="input" value="<%= settings.store_tagline || '' %>" />
    </label>
    <label>العملة
      <input name="currency" class="input" value="<%= settings.currency || 'MAD' %>" />
    </label>
  </fieldset>

  <fieldset>
    <legend>التسعير</legend>
    <label>نسبة الزيادة الافتراضية عند الاستيراد (%)
      <input name="default_markup_pct" type="number" min="0" max="500" step="0.1" class="input" value="<%= getSet('default_markup_pct', '30') %>" />
      <small class="muted">عند استيراد منتوج، يُقترح سعر بيع = السعر الأصلي × (1 + هذه النسبة). يمكنك تعديله قبل النشر.</small>
    </label>
  </fieldset>

  <fieldset>
    <legend>الشحن (لا يدخل في الأرباح)</legend>
    <label>رسوم الشحن الثابتة (<%= settings.currency || 'MAD' %>)
      <input name="shipping_fee" type="number" min="0" step="0.01" class="input" value="<%= getSet('shipping_fee', '30') %>" />
      <small class="muted">المبلغ الذي يُضاف على كل طلب تلقائياً. يمكن تعديله يدوياً لكل طلب من صفحة "الطلبات".</small>
    </label>
    <label>حد الشحن المجاني (<%= settings.currency || 'MAD' %>)
      <input name="free_shipping_threshold" type="number" min="0" step="0.01" class="input" value="<%= getSet('free_shipping_threshold', '0') %>" />
      <small class="muted">إذا كان مجموع السلة ≥ هذا المبلغ، يصبح الشحن مجانياً. اترك 0 لتعطيل الشحن المجاني.</small>
    </label>
  </fieldset>

  <fieldset>
    <legend>📧 إشعارات البريد (Gmail — مجاني)</legend>
    <label class="check">
      <input type="checkbox" name="notify_email_enabled" <%= getSet('notify_email_enabled', '0') === '1' ? 'checked' : '' %> />
      <span>تفعيل الإشعارات عبر البريد</span>
    </label>
    <label>إيميل المُرسِل (Gmail)
      <input name="notify_email_from" type="email" class="input" value="<%= getSet('notify_email_from', '') %>" placeholder="yourstore@gmail.com" />
      <small class="muted">يجب أن يكون Gmail، ولازم تضيف App Password في Railway (انظر التعليمات).</small>
    </label>
    <label>إيميل الاستلام
      <input name="notify_email_to" type="email" class="input" value="<%= getSet('notify_email_to', '') %>" placeholder="you@gmail.com" />
      <small class="muted">الإيميل الذي تستلم عليه إشعار كل طلب جديد.</small>
    </label>
    <div class="alert info">
      <strong>🔐 App Password:</strong> أضف متغير <code>GMAIL_APP_PASSWORD</code> في Railway → Variables
      (مو في هذا الفورم للأمان). القيمة: كلمة مرور 16 حرف من Google Account → Security → App passwords.
    </div>
  </fieldset>

  <fieldset>
    <legend>💬 إشعارات WhatsApp (مجاني عبر CallMeBot)</legend>
    <label class="check">
      <input type="checkbox" name="notify_whatsapp_enabled" <%= getSet('notify_whatsapp_enabled', '0') === '1' ? 'checked' : '' %> />
      <span>تفعيل الإشعارات عبر WhatsApp</span>
    </label>
    <label>رقم WhatsApp (مع رمز الدولة)
      <input name="notify_whatsapp_phone" class="input" value="<%= getSet('notify_whatsapp_phone', '') %>" placeholder="+212612345678" />
      <small class="muted">مثلاً للمغرب: +212612345678. لازم يكون نفس الرقم اللي ربطته مع CallMeBot.</small>
    </label>
    <label>CallMeBot API Key
      <input name="notify_whatsapp_apikey" class="input" value="<%= getSet('notify_whatsapp_apikey', '') %>" placeholder="مثال: 1234567" />
      <small class="muted">احصل عليه: أرسل "I allow callmebot to send me messages" إلى +34 644 59 71 47 على WhatsApp، ثم ردّ على الرسالة بكلمة "I allow".</small>
    </label>
  </fieldset>

  <div class="alert warn">
    <strong>تغيير كلمة مرور لوحة التحكم:</strong> افتح ملف <code>data/store.db</code> بأي أداة SQLite
    ونفّذ: <code>UPDATE settings SET value='كلمة_جديدة' WHERE key='admin_token';</code>
    ثم سجّل خروج وأعد الدخول.
  </div>

  <button class="btn btn-primary" type="submit">💾 حفظ الإعدادات</button>
</form>

<%- include('../partials/admin-footer') %>
